[Unit]
Description=RomanOS · inicio automático en la sesión de prueba (USB)
ConditionKernelCommandLine=boot=casper
After=casper.service systemd-user-sessions.service
Before=lightdm.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/lib/romanos/live-autologin.sh

[Install]
WantedBy=multi-user.target
