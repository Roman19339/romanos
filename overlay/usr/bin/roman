#!/usr/bin/env python3
"""roman — Claude desde la terminal de RomanOS.

  roman "¿qué facturas vencen esta semana?"
  roman                      (modo conversación; 'salir' para terminar)
  cat lista.txt | roman "ordena esta lista de pedido por proveedor"
"""
import json
import os
import sys
import urllib.request
from pathlib import Path

AI = "http://127.0.0.1:7777"
TOK = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "romanos" / ".token"


def preguntar(messages):
    if not TOK.exists():
        sys.exit("El servicio de Claude no está corriendo. Prueba: systemctl --user start romanos-ai")
    req = urllib.request.Request(AI + "/api/chat", data=json.dumps({"messages": messages}).encode(),
                                 headers={"Content-Type": "application/json", "X-Roman-Token": TOK.read_text().strip()})
    with urllib.request.urlopen(req, timeout=300) as r:
        return json.loads(r.read())


def turno(messages, texto):
    messages.append({"role": "user", "content": texto})
    sys.stderr.write("\033[2m… pensando\033[0m\r")
    j = preguntar(messages)
    sys.stderr.write("            \r")
    if j.get("error"):
        messages.pop()
        print("\033[31m" + j["error"] + "\033[0m")
        return
    usadas = ", ".join(t["herramienta"] for t in j.get("herramientas", []))
    if usadas:
        print(f"\033[2m[{usadas}]\033[0m")
    print(j.get("respuesta", ""))
    messages.append({"role": "assistant", "content": j.get("respuesta", "")})


def main():
    args = " ".join(sys.argv[1:]).strip()
    entrada = ""
    if not sys.stdin.isatty():
        import select
        # Lee lo que venga por tubería (cat archivo | roman …) sin quedarse esperando
        if select.select([sys.stdin], [], [], 0.3)[0]:
            entrada = sys.stdin.read()
    messages = []
    if args or entrada:
        turno(messages, (args + ("\n\n" + entrada if entrada else "")).strip())
        return
    print("Claude · RomanOS  (escribe 'salir' para terminar)\n")
    while True:
        try:
            t = input("\033[1;31mtú ›\033[0m ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if t.lower() in ("salir", "exit", "q"):
            break
        if t:
            turno(messages, t)
            print()


if __name__ == "__main__":
    main()
